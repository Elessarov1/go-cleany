# Copy to .env.production on the VPS and set chmod 600. Never commit the real file.

# Public hostname without protocol. Until a domain is purchased, a temporary staging value can be
# built from the VPS IPv4 address: go-cleany-203-0-113-10.nip.io
APP_HOST=CHANGE_ME.example.com
ACME_EMAIL=CHANGE_ME@example.com

# PostgreSQL is reachable only from the private Docker network.
POSTGRES_DB=go_cleany
POSTGRES_USER=go_cleany
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Telegram bot and access lists. Comma-separated IDs must not contain spaces.
TELEGRAM_BOT_TOKEN=CHANGE_ME
CLEANER_TELEGRAM_IDS=CHANGE_ME
ADMIN_TELEGRAM_IDS=CHANGE_ME
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_POLLING_RETRY_DELAY=3s
TELEGRAM_POLLING_DROP_PENDING_UPDATES=false

# Referral Financial Model v1 (TRY)
REFERRAL_COMMISSION_RATE=0.15
REFERRAL_FRIEND_DISCOUNT_RATE=0.15
REFERRAL_FRIEND_MAX_DISCOUNT=2000
REFERRAL_REFERRER_REWARD_RATE=0.10
REFERRAL_REFERRER_MAX_DISCOUNT=2000
REFERRAL_PARTNER_CUSTOMER_DISCOUNT_RATE=0.05
REFERRAL_PARTNER_CUSTOMER_MAX_DISCOUNT=2000
REFERRAL_PARTNER_PAYOUT_RATE=0.10
REFERRAL_PARTNER_MAX_PAYOUT=2000

# Onsite issue evidence
ONSITE_ISSUE_MIN_PHOTOS=3
ONSITE_ISSUE_MAX_PHOTOS=8
ONSITE_ISSUE_MAX_PHOTO_SIZE=5MB
ONSITE_ISSUE_SUPPORTED_CONTENT_TYPES=image/jpeg,image/png
TELEGRAM_INIT_DATA_MAX_AGE=1h
TELEGRAM_INIT_DATA_ALLOWED_CLOCK_SKEW=30s

# Rental policy (individual apartment prices are managed in the admin UI).
RENTAL_MIN_STAY_DAYS=7
RENTAL_LONG_TERM_MIN_DAYS=30
RENTAL_LONG_TERM_DISCOUNT_RATE=0.10
RENTAL_MAX_STAY_DAYS=365
RENTAL_BOOKING_START_MONTHS_AHEAD=6
RENTAL_MAX_ACTIVE_BOOKINGS_PER_CUSTOMER=3

# Personal go-renty checkout-cleaning benefit (TRY).
RENTAL_CLEANING_BENEFIT_ENABLED=true
RENTAL_CLEANING_BENEFIT_CRON="0 15 4 * * *"
RENTAL_CLEANING_BENEFIT_BATCH_SIZE=100
RENTAL_CLEANING_CHECKOUT_WINDOW_DAYS=3
RENTAL_CLEANING_DISCOUNT_RATE=0.10
RENTAL_CLEANING_MAX_DISCOUNT=2000

# Database payload cleanup and deployment backup retention.
DATA_CLEANUP_ENABLED=true
DATA_RETENTION_DAYS=7
DATA_CLEANUP_CRON="0 30 3 * * *"
DATA_CLEANUP_BATCH_SIZE=100
DATA_CLEANUP_MAX_BATCHES_PER_RUN=10
GO_CLEANY_BACKUP_RETENTION_DAYS=7
# GO_CLEANY_BACKUP_DIR=/opt/go-cleany/backups

# Confirm these business values before production launch.
CLEANING_BOOKING_DAYS_AHEAD=7
CLEANING_PRICES_REGULAR_STUDIO=CHANGE_ME
CLEANING_PRICES_REGULAR_ONE_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_REGULAR_TWO_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_REGULAR_THREE_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_REGULAR_FOUR_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_REGULAR_DUPLEX_SURCHARGE=CHANGE_ME
CLEANING_PRICES_DEEP_STUDIO=CHANGE_ME
CLEANING_PRICES_DEEP_ONE_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_DEEP_TWO_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_DEEP_THREE_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_DEEP_FOUR_PLUS_ONE=CHANGE_ME
CLEANING_PRICES_DEEP_DUPLEX_SURCHARGE=CHANGE_ME

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError

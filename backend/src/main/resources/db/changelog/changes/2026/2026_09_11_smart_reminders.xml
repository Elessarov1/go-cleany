<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20260911-01" author="loco-place">
        <comment>Persist deterministic customer reminders and their delivery lifecycle.</comment>
        <createTable tableName="customer_reminder">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_customer_reminder" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="type" type="VARCHAR(48)"><constraints nullable="false"/></column>
            <column name="source_service" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="source_entity_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="scheduled_date" type="DATE"/>
            <column name="cleaning_interval_days" type="INTEGER"/>
            <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="notified_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="customer_reminder"
                                 baseColumnNames="customer_id"
                                 constraintName="fk_customer_reminder_customer"
                                 referencedTableName="customer_account"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="customer_reminder"
                             columnNames="customer_id,type,source_service,source_entity_id"
                             constraintName="uk_customer_reminder_source"/>
        <createIndex tableName="customer_reminder" indexName="idx_customer_reminder_due">
            <column name="status"/>
            <column name="scheduled_date"/>
            <column name="id"/>
        </createIndex>
        <sql dbms="postgresql"><![CDATA[
            alter table customer_reminder
                add constraint ck_customer_reminder_type check (
                    type in ('CLEANING_REPEAT', 'RENTAL_CHECKOUT_TRANSFER', 'TRANSFER_UPCOMING')
                ),
                add constraint ck_customer_reminder_source_service check (
                    (type = 'CLEANING_REPEAT' and source_service = 'CLEANING')
                    or (type = 'RENTAL_CHECKOUT_TRANSFER' and source_service = 'RENTAL')
                    or (type = 'TRANSFER_UPCOMING' and source_service = 'TRANSFER')
                ),
                add constraint ck_customer_reminder_source check (source_entity_id > 0),
                add constraint ck_customer_reminder_status check (
                    status in ('PENDING', 'NOTIFIED', 'DISABLED', 'SUPERSEDED', 'EXPIRED')
                ),
                add constraint ck_customer_reminder_cleaning_interval check (
                    (type = 'CLEANING_REPEAT' and (
                        (status = 'DISABLED' and cleaning_interval_days is null)
                        or (status <> 'DISABLED' and cleaning_interval_days in (14, 30))
                    ))
                    or (type <> 'CLEANING_REPEAT' and cleaning_interval_days is null)
                ),
                add constraint ck_customer_reminder_schedule check (
                    (status = 'DISABLED' and scheduled_date is null)
                    or (status <> 'DISABLED' and scheduled_date is not null)
                );
        ]]></sql>
        <rollback>
            <dropTable tableName="customer_reminder"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20260905-01" author="loco-place">
        <comment>Create the independent Loco Transfer domain and register its platform dimensions.</comment>

        <sql dbms="postgresql"><![CDATA[
            alter table platform_service_state drop constraint ck_platform_service_state_service;
            alter table platform_service_state
                add constraint ck_platform_service_state_service
                    check (service in ('CLEANING', 'RENTAL', 'TRANSFER'));

            alter table acquisition_campaign drop constraint ck_acquisition_campaign_target_service;
            alter table acquisition_campaign
                add constraint ck_acquisition_campaign_target_service
                    check (target_service in ('PLATFORM', 'CLEANING', 'RENTAL', 'TRANSFER'));

            alter table customer_acquisition drop constraint ck_customer_acquisition_service;
            alter table customer_acquisition
                add constraint ck_customer_acquisition_service
                    check (first_touch_service is null or first_touch_service in ('CLEANING', 'RENTAL', 'TRANSFER'));
        ]]></sql>

        <insert tableName="platform_service_state">
            <column name="service" value="TRANSFER"/>
            <column name="status" value="IN_TEST"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="version" valueNumeric="0"/>
        </insert>

        <createTable tableName="transfer_airport">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_transfer_airport" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="name_ru" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="name_en" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="enabled" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="sort_order" type="INTEGER"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="transfer_airport" columnNames="code"
                             constraintName="uk_transfer_airport_code"/>
        <createIndex tableName="transfer_airport" indexName="idx_transfer_airport_enabled_order">
            <column name="enabled"/>
            <column name="sort_order"/>
            <column name="id"/>
        </createIndex>

        <createTable tableName="transfer_vehicle_type">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_transfer_vehicle_type" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="name_ru" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="name_en" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="max_passengers" type="INTEGER"><constraints nullable="false"/></column>
            <column name="max_luggage" type="INTEGER"><constraints nullable="false"/></column>
            <column name="enabled" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="sort_order" type="INTEGER"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="transfer_vehicle_type" columnNames="code"
                             constraintName="uk_transfer_vehicle_type_code"/>
        <createIndex tableName="transfer_vehicle_type" indexName="idx_transfer_vehicle_enabled_order">
            <column name="enabled"/>
            <column name="sort_order"/>
            <column name="id"/>
        </createIndex>

        <createTable tableName="transfer_price">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_transfer_price" nullable="false"/>
            </column>
            <column name="airport_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="vehicle_type_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="direction" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="amount" type="NUMERIC(12,2)"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="enabled" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="transfer_price" baseColumnNames="airport_id"
                                 constraintName="fk_transfer_price_airport"
                                 referencedTableName="transfer_airport" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="transfer_price" baseColumnNames="vehicle_type_id"
                                 constraintName="fk_transfer_price_vehicle"
                                 referencedTableName="transfer_vehicle_type" referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
        <addUniqueConstraint tableName="transfer_price"
                             columnNames="airport_id,vehicle_type_id,direction"
                             constraintName="uk_transfer_price_route_vehicle"/>
        <createIndex tableName="transfer_price" indexName="idx_transfer_price_enabled_route">
            <column name="enabled"/>
            <column name="airport_id"/>
            <column name="vehicle_type_id"/>
            <column name="direction"/>
        </createIndex>


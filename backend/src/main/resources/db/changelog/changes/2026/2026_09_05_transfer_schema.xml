        <dropDefaultValue tableName="transfer_airport" columnName="version"/>
        <dropDefaultValue tableName="transfer_vehicle_type" columnName="version"/>
        <dropDefaultValue tableName="transfer_price" columnName="version"/>
        <dropDefaultValue tableName="transfer_driver" columnName="version"/>
        <dropDefaultValue tableName="transfer_booking" columnName="version"/>

        <rollback>
            <dropTable tableName="transfer_booking"/>
            <dropTable tableName="transfer_price"/>
            <dropTable tableName="transfer_driver_link_token"/>
            <dropTable tableName="transfer_driver"/>
            <dropTable tableName="transfer_vehicle_type"/>
            <dropTable tableName="transfer_airport"/>
            <delete tableName="platform_service_state"><where>service = 'TRANSFER'</where></delete>
            <sql dbms="postgresql"><![CDATA[
                alter table platform_service_state drop constraint ck_platform_service_state_service;
                alter table platform_service_state
                    add constraint ck_platform_service_state_service
                        check (service in ('CLEANING', 'RENTAL'));
                alter table acquisition_campaign drop constraint ck_acquisition_campaign_target_service;
                alter table acquisition_campaign
                    add constraint ck_acquisition_campaign_target_service
                        check (target_service in ('PLATFORM', 'CLEANING', 'RENTAL'));
                alter table customer_acquisition drop constraint ck_customer_acquisition_service;
                alter table customer_acquisition
                    add constraint ck_customer_acquisition_service
                        check (first_touch_service is null or first_touch_service in ('CLEANING', 'RENTAL'));
            ]]></sql>
        </rollback>
    </changeSet>
</databaseChangeLog>

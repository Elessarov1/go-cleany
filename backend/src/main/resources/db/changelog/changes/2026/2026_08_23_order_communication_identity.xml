<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20260823-01" author="go-cleany">
        <comment>
            Expand cleaning orders with the external identity that owns their operational communication.
            The new column intentionally remains nullable at database level until the previous application
            version can no longer write orders without it.
        </comment>

        <addColumn tableName="cleaning_order">
            <column name="communication_identity_id" type="BIGINT"/>
        </addColumn>

        <sql dbms="postgresql"><![CDATA[
            update cleaning_order orders
               set communication_identity_id = identity.id
              from customer_external_identity identity
             where identity.customer_id = orders.customer_id
               and identity.provider = 'TELEGRAM'
               and identity.external_subject = orders.telegram_user_id::text
               and orders.communication_identity_id is null;
        ]]></sql>

        <rollback>
            <dropColumn tableName="cleaning_order" columnName="communication_identity_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20260823-02" author="go-cleany">
        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="0">
                select count(*) from cleaning_order where communication_identity_id is null
            </sqlCheck>
        </preConditions>

        <comment>
            Verify the historical backfill, add referential integrity, and make the Telegram snapshot optional.
        </comment>

        <addUniqueConstraint
                tableName="customer_external_identity"
                columnNames="id, customer_id"
                constraintName="uk_customer_external_identity_id_customer"/>
        <addForeignKeyConstraint
                baseTableName="cleaning_order"
                baseColumnNames="communication_identity_id, customer_id"
                constraintName="fk_cleaning_order_communication_identity"
                referencedTableName="customer_external_identity"
                referencedColumnNames="id, customer_id"/>
        <createIndex tableName="cleaning_order" indexName="idx_cleaning_order_communication_identity">
            <column name="communication_identity_id"/>
        </createIndex>
        <dropNotNullConstraint
                tableName="cleaning_order"
                columnName="telegram_user_id"
                columnDataType="BIGINT"/>

        <rollback>
            <sql dbms="postgresql"><![CDATA[
                update cleaning_order orders
                   set telegram_user_id = identity.external_subject::bigint,
                       telegram_username = identity.username
                  from customer_external_identity identity
                 where identity.id = orders.communication_identity_id
                   and identity.provider = 'TELEGRAM'
                   and orders.telegram_user_id is null;
            ]]></sql>
            <addNotNullConstraint
                    tableName="cleaning_order"
                    columnName="telegram_user_id"
                    columnDataType="BIGINT"/>
            <dropIndex tableName="cleaning_order" indexName="idx_cleaning_order_communication_identity"/>
            <dropForeignKeyConstraint
                    baseTableName="cleaning_order"
                    constraintName="fk_cleaning_order_communication_identity"/>
            <dropUniqueConstraint
                    tableName="customer_external_identity"
                    constraintName="uk_customer_external_identity_id_customer"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

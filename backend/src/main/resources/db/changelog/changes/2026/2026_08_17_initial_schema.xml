<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20260817-01" author="cleany">
        <createTable tableName="cleaning_order">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_cleaning_order" nullable="false"/>
            </column>
            <column name="telegram_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="telegram_username" type="VARCHAR(64)"/>
            <column name="customer_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="area" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="apartment_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="duplex" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="cleaning_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="customer_comment" type="VARCHAR(1000)"/>
            <column name="cleaner_comment" type="VARCHAR(1000)"/>
            <column name="cleaner_telegram_user_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createIndex tableName="cleaning_order" indexName="idx_cleaning_order_telegram_user_id">
            <column name="telegram_user_id"/>
        </createIndex>
        <createIndex tableName="cleaning_order" indexName="idx_cleaning_order_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="cleaning_order" indexName="idx_cleaning_order_requested_date">
            <column name="requested_date"/>
        </createIndex>
        <createIndex tableName="cleaning_order" indexName="idx_cleaning_order_created_at">
            <column name="created_at"/>
        </createIndex>

        <sql dbms="postgresql">
            alter table cleaning_order
                add constraint ck_cleaning_order_price_non_negative check (price &gt;= 0),
                add constraint ck_cleaning_order_area
                    check (area in ('MAHMUTLAR', 'KARGICAK', 'KESTEL')),
                add constraint ck_cleaning_order_apartment_type
                    check (apartment_type in ('STUDIO', 'ONE_PLUS_ONE', 'TWO_PLUS_ONE', 'THREE_PLUS_ONE', 'FOUR_PLUS_ONE')),
                add constraint ck_cleaning_order_cleaning_type
                    check (cleaning_type in ('REGULAR', 'DEEP')),
                add constraint ck_cleaning_order_status
                    check (status in ('NEW', 'ACCEPTED', 'AWAITING_REPORT', 'COMPLETED', 'REJECTED', 'CANCELLED'));
        </sql>

        <rollback>
            <dropTable tableName="cleaning_order"/>
        </rollback>
    </changeSet>

    <changeSet id="20260817-02" author="cleany">
        <createTable tableName="cleaning_order_photo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_cleaning_order_photo" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="telegram_file_id" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="telegram_file_unique_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="cleaning_order_photo"
                baseColumnNames="order_id"
                constraintName="fk_cleaning_order_photo_order"
                referencedTableName="cleaning_order"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="cleaning_order_photo" indexName="idx_cleaning_order_photo_order_id">
            <column name="order_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="cleaning_order_photo"/>
        </rollback>
    </changeSet>
</databaseChangeLog>


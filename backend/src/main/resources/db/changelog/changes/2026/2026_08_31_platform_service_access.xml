<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20260831-01" author="go-cleany">
        <createTable tableName="customer_role">
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
                tableName="customer_role"
                columnNames="customer_id, role"
                constraintName="pk_customer_role"/>
        <addForeignKeyConstraint
                baseTableName="customer_role"
                baseColumnNames="customer_id"
                constraintName="fk_customer_role_customer"
                referencedTableName="customer_account"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        <sql dbms="postgresql">
            alter table customer_role
                add constraint ck_customer_role_role check (role in ('ADMIN'));
        </sql>

        <createTable tableName="platform_service_state">
            <column name="service" type="VARCHAR(32)">
                <constraints primaryKey="true" primaryKeyName="pk_platform_service_state" nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by_customer_id" type="BIGINT"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="platform_service_state"
                baseColumnNames="updated_by_customer_id"
                constraintName="fk_platform_service_state_updater"
                referencedTableName="customer_account"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
        <sql dbms="postgresql"><![CDATA[
            alter table platform_service_state
                add constraint ck_platform_service_state_service
                    check (service in ('CLEANING', 'RENTAL')),
                add constraint ck_platform_service_state_status
                    check (status in ('ENABLED', 'IN_TEST', 'DISABLED'));

            insert into platform_service_state (
                service, status, updated_at, updated_by_customer_id, version
            ) values
                ('CLEANING', 'ENABLED', current_timestamp, null, 0),
                ('RENTAL', 'ENABLED', current_timestamp, null, 0);
        ]]></sql>
        <dropDefaultValue tableName="platform_service_state" columnName="version"/>

        <rollback>
            <dropTable tableName="platform_service_state"/>
            <dropTable tableName="customer_role"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

# Copy this file to .env.docker. Never commit the resulting file.

# Required: token issued by BotFather. An empty value intentionally prevents Compose startup.
TELEGRAM_BOT_TOKEN=

# Use 1 for the first start, ask the bot for /whoami, then replace all three IDs and restart backend.
CLEANER_TELEGRAM_IDS=1
LOCAL_TELEGRAM_USER_ID=1
ADMIN_TELEGRAM_IDS=1
LOCAL_TELEGRAM_USERNAME=browser_preview
LOCAL_TELEGRAM_FIRST_NAME=Alex
LOCAL_TELEGRAM_LAST_NAME=

TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_POLLING_RETRY_DELAY=3s
TELEGRAM_POLLING_DROP_PENDING_UPDATES=false

POSTGRES_DB=cleany
POSTGRES_USER=cleany
POSTGRES_PASSWORD=cleany-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
